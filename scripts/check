#!/usr/bin/env bash
set -euo pipefail

echo "==> Checking code formatting (cargo fmt)..."
cargo fmt --check

echo "==> Running static analysis (cargo clippy)..."
cargo clippy --workspace --all-targets -- -D warnings

echo "==> Running test suite (cargo test)..."
cargo test --workspace

echo "==> Running durability benchmark (cargo bench -p wal)..."
cargo bench -p wal

echo "==> Running hot-path benchmark + regression gate (criterion, baseline.json)..."
python3 scripts/bench_gate.py

echo "==> Building documentation (cargo doc)..."
cargo doc --workspace --no-deps

echo "==> All quality gates passed successfully!"
